# Copy to .env (never commit it) or set these in your shell / host dashboard. Everything is optional.
# --- wagmi_tracker data sources ---
HELIUS_API_KEY=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
OPENSEA_API_KEY=
TELEGRAM_BOT_TOKEN=
XAI_API_KEY=
# --- x402 Agent API (Solana DEVNET only) ---
# Public key that receives payments. Defaults to the pubkey of .secrets/server_payto.json
X402_PAY_TO=
# payai (default, PayAI facilitator sponsors the fee) | local (this server is the fee payer) | a facilitator URL
X402_FACILITATOR=payai
# Only for X402_FACILITATOR=local: the fee payer's secret key (JSON byte array or base58). Keep it out of git.
X402_FEEPAYER_SECRET=
# Devnet USDC by default
X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
X402_DECIMALS=6
# Price in atomic units (10000 = 0.01 USDC)
X402_PRICE=10000
X402_TIMEOUT=120
X402_WAIT=20
# HMAC key for quotes. Defaults to a generated .secrets/x402_hmac
X402_SECRET=
DEVNET_RPC=https://api.devnet.solana.com
